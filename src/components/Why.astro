---
import { why, links } from '../data/campaign';

/**
 * Text only, by decision. No candid portrait has been supplied and none is
 * substituted. If an approved photograph arrives later, add it here and change
 * .single back to a two column layout. No placeholder is ever published.
 */
---
<section id="why" class="section surface-green" aria-labelledby="why-title">
  <div class="wrap">
    <div class="single">
      <div>
        <p class="eyebrow">{why.eyebrow}</p>
        <h2 id="why-title" class="display section-title">{why.heading}</h2>
        <hr class="rule" />
        <p class="lead">{why.opening}</p>
        <p class="why__question">{why.question}</p>
        {why.body.map((para) => <p>{para}</p>)}
        <div class="actions">
          <a class="btn btn--outline" href={links.lachlanStuart} rel="noopener">
            {why.linkLabel}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Centred so it reads as a deliberate statement section rather than a two
     column layout with the image missing. */
  .single { max-width: 62ch; margin-inline: auto; }

  /* The existing question, given weight rather than repetition. Display type on
     the section's own green, no quotation marks and no rule, so it reads as the
     sentence it already is rather than as a pulled testimonial. It stays a
     paragraph in the flow, so the reading order is unchanged. */
  .why__question {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 4.2vw, 2.75rem);
    letter-spacing: var(--tracking-display);
    line-height: 1.04;
    color: var(--on-green-1);
    margin: var(--space-5) 0 var(--space-6);
    max-width: 20ch;
  }
</style>

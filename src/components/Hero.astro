---
import { campaign, links } from '../data/campaign';
import Photograph from './Photograph.astro';
---
<section id="hero" class="hero surface-dark" aria-labelledby="hero-title">
  <div class="wrap hero__layout">
    <div class="hero__heading">
      <p class="eyebrow">{campaign.participant}</p>
      <h1 id="hero-title" class="display">The Long<br />Road <span>Home</span></h1>
      <p class="hero__opening">{campaign.headline}</p>
    </div>
    <figure class="hero__photo">
      <Photograph photo="running-desert" priority
           alt="Lachlan running along a road through an open, dry landscape."
           sizes="(max-width: 47.5rem) calc(100vw - 2.5rem), (max-width: 56.25rem) 48rem, (max-width: 75rem) 52vw, 36rem" />
    </figure>
    <div class="hero__copy">
      <p class="hero__intro">{campaign.supporting}</p>
      <div class="hero__actions">
        <a class="btn btn--gold" href={links.fundraising}>Donate to Top Blokes <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#follow">Join my email list <span aria-hidden="true">↓</span></a>
      </div>
      <p class="hero__date">Planned start · {campaign.plannedStart}</p>
    </div>
  </div>
</section>
<style>
  .hero { padding-block: clamp(2rem, 3vw, 3rem) clamp(2.5rem, 4vw, 4rem); }
  .hero__layout { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); grid-template-areas: 'heading photo' 'copy photo'; column-gap: clamp(2.5rem, 5vw, 5rem); align-items: center; }
  .hero__heading { grid-area: heading; }
  .hero__copy { grid-area: copy; }
  .hero h1 { font-size: clamp(5rem, 8.4vw, 8.4rem); line-height: .85; letter-spacing: -.015em; }
  .hero h1 span { color: var(--gold); }
  .hero__opening { margin: 1.75rem 0 1rem; font-size: clamp(1.15rem, 1.8vw, 1.4rem); line-height: 1.45; }
  .hero__intro { color: var(--on-dark-2); max-width: 34rem; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 1.25rem 1.5rem; align-items: center; margin-top: 1.75rem; }
  .hero__actions .text-link { font-size: .875rem; }
  .hero__date { margin: 2rem 0 0; font-size: .875rem; color: var(--on-dark-2); }
  .hero__photo { grid-area: photo; min-width: 0; margin: 0; }
  .hero__photo img { width: 100%; height: auto; }
  @media (max-width: 56.25rem) {
    .hero { padding-block: 1.75rem 2.5rem; }
    .hero__layout { grid-template-columns: 1fr; grid-template-areas: 'heading' 'photo' 'copy'; gap: 1.5rem; }
    .hero__opening { margin-bottom: 0; }
    .hero h1 { font-size: clamp(5rem, 13vw, 7.5rem); }
    .hero__intro { max-width: 42rem; }
    .hero__photo { max-width: 48rem; }
    .hero__date { margin-top: 1.25rem; }
  }
  @media (max-width: 27rem) {
    .hero h1 { font-size: clamp(4.5rem, 23vw, 6rem); }
    .hero__actions { align-items: flex-start; flex-direction: column; }
    .hero__actions .btn { white-space: normal; width: 100%; }
  }
</style>

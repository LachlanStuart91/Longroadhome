---
import { campaign, challenge } from '../data/campaign';

/**
 * The journey axis. An ABSTRACT west to east distance relationship between the
 * two confirmed endpoints, and nothing more. It is deliberately a straight
 * rule with no bearing, no bends, no towns, no coordinates, no arrows and no
 * completion state, so it can never be read as a route, a map or a progress
 * bar. The detailed route is still in planning and is not published anywhere.
 *
 * Direction is carried by the two markers: the origin is solid, the
 * destination is open. "No rest days" sits beneath as a condition of the
 * journey, not as a third destination.
 */
---
<section id="the-run" class="section surface-dark grain" aria-labelledby="the-run-title">
  <div class="wrap">
    <p class="eyebrow">{challenge.eyebrow}</p>
    <h2 id="the-run-title" class="display section-title">{challenge.heading}</h2>
    <hr class="rule" />

    <p class="lead">{challenge.body[0]}</p>
    <p>{challenge.body[1]}</p>

    <div class="axis">
      <dl class="axis__ends">
        <div class="axis__end axis__end--origin">
          <dt class="axis__place">{campaign.startPlace}</dt>
          <dd class="axis__meta">Start, {campaign.startRegion}</dd>
        </div>
        <div class="axis__end axis__end--destination">
          <dt class="axis__place">{campaign.finishPlace}</dt>
          <dd class="axis__meta">Finish, {campaign.finishRegion}</dd>
        </div>
      </dl>

      <div class="axis__rail" aria-hidden="true">
        <span class="axis__marker axis__marker--origin"></span>
        <span class="axis__track"><span class="axis__draw"></span></span>
        <span class="axis__marker axis__marker--destination"></span>
      </div>

      <p class="axis__distance">{campaign.planningDistance}</p>

      <dl class="axis__condition">
        <dt class="axis__condition-label">Planned schedule</dt>
        <dd class="axis__condition-value">{campaign.noRestDays}</dd>
      </dl>
    </div>
  </div>
</section>

<style>
  .axis { margin-top: var(--space-8); max-width: 60rem; }

  .axis__ends { display: flex; justify-content: space-between; gap: var(--space-6); margin: 0; }
  .axis__end { margin: 0; }
  .axis__end--destination { text-align: right; }
  .axis__place {
    font-family: var(--font-display); font-size: clamp(1.5rem, 2.6vw, 2.125rem);
    letter-spacing: 0.03em; line-height: 1.06; color: var(--on-dark-1); margin: 0;
  }
  .axis__meta {
    font-family: var(--font-support); font-weight: 600; font-size: 0.8125rem;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--on-dark-2);
    margin: 0.625rem 0 0;
  }

  .axis__rail {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center;
    gap: 0.625rem; margin-top: 1.5rem;
  }
  /* Solid origin, open destination. Direction is read from the difference
     between the two markers, not from an arrow or a compass. */
  .axis__marker { width: 10px; height: 10px; border-radius: 50%; }
  .axis__marker--origin { background: var(--gold); }
  .axis__marker--destination { background: transparent; box-shadow: inset 0 0 0 2px var(--gold); }

  .axis__track { height: 2px; background: rgba(230, 227, 218, 0.20); position: relative; overflow: hidden; }
  .axis__draw { position: absolute; inset: 0; background: var(--gold); transform-origin: left center; }

  /* max-width is reset because the global paragraph rule caps text at the
     reading measure, which would stop this centring across the axis. */
  .axis__distance {
    max-width: none; text-align: center; margin: 0.875rem 0 0;
    font-family: var(--font-support); font-weight: 600; font-size: 0.9375rem;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold);
  }

  /* Subordinate to both the endpoints and the distance, and given no rule of
     its own so it does not read as a separate unfinished component. */
  .axis__condition { margin: 1.375rem 0 0; text-align: center; }
  .axis__condition-label {
    font-family: var(--font-support); font-weight: 600; font-size: 0.75rem;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--on-dark-2); margin: 0;
  }
  .axis__condition-value {
    font-family: var(--font-support); font-weight: 600; font-size: 0.9375rem;
    letter-spacing: 0.02em; color: var(--on-dark-1); margin: 0.375rem 0 0;
  }

  /* One animation on the whole site. The axis is DRAWN by default, so it is
     complete when JavaScript does not run. The undrawn state exists only once
     the script has opted in, and under reduced motion it never opts in. */
  :global(.js-axis) .axis__draw { transform: scaleX(0); }
  :global(.js-axis) .axis.is-drawn .axis__draw {
    transform: scaleX(1);
    transition: transform 700ms cubic-bezier(0.45, 0.05, 0.25, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js-axis) .axis .axis__draw,
    :global(.js-axis) .axis.is-drawn .axis__draw { transform: scaleX(1); transition: none; }
  }

  /* Stacked. A plain vertical list with horizontal separators. The horizontal
     axis is not attempted at these widths. */
  @media (max-width: 47.5rem) {
    .axis__ends { display: block; }
    .axis__end { padding: var(--space-4) 0; border-bottom: 1px solid var(--hairline-dark); }
    .axis__end--destination { text-align: left; }
    .axis__place { font-size: 1.5rem; }
    .axis__rail { display: none; }
    .axis__distance { text-align: left; margin-top: var(--space-5); }
    .axis__condition { text-align: left; margin-top: var(--space-5); }
  }
</style>

<script>
  /**
   * The only animation on the site. It draws the distance axis once, when the
   * section first comes into view.
   *
   * The axis is drawn by default in CSS. This script is the ONLY thing that
   * introduces the undrawn state, and it does so only when motion is welcome,
   * so the completed axis is what appears if the script never runs or if the
   * visitor prefers reduced motion. There is no scroll listener and no library.
   */
  const root = document.documentElement;
  const axis = document.querySelector('.axis');

  if (axis && 'IntersectionObserver' in window) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!reduce.matches) {
      root.classList.add('js-axis');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-drawn');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.35 });
      observer.observe(axis);
    }
  }
</script>

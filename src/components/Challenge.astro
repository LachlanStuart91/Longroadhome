---
import { campaign } from '../data/campaign';
import VideoMessage from './VideoMessage.astro';
---
<section id="the-run" class="run surface-light" aria-labelledby="the-run-title">
  <div class="wrap run__layout">
    <div class="run__film">
      <p class="eyebrow">The story behind the run</p>
      <VideoMessage />
    </div>
    <div class="run__copy">
      <h2 id="the-run-title" class="editorial-title">{campaign.start}<br /><span class="run__to">to</span> {campaign.finish}.</h2>
      <p class="run__places">Planned start · {campaign.plannedStart}</p>
      <p class="run__plan">{campaign.planningDistance}. A goal of {campaign.dailyGoalMetric}, with no rest days planned.</p>
      <p class="run__details">I'll have a support crew and vehicle with me. {campaign.routeStatus} I'll share the final details once they're settled.</p>
    </div>
  </div>
</section>
<style>
  .run { padding-block: clamp(2.5rem, 4vw, 4rem); background: #faf9f5; }
  .run__layout { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: clamp(2.5rem, 6vw, 5rem); align-items: center; }
  .run h2 { max-width: 22ch; font-size: clamp(1.875rem, 3vw, 2.625rem); }
  .run__to { color: var(--terrain); }
  .run__places { font-size: .875rem; color: var(--on-light-2); margin: 1rem 0 1.75rem; }
  .run__plan { max-width: 31rem; font-size: 1.125rem; }
  .run__details { color: var(--on-light-2); font-size: 1rem; margin-bottom: 0; }
  @media (max-width: 56.25rem) { .run__layout { grid-template-columns: 1fr; } }
</style>

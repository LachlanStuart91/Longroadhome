---
import { challenge } from '../data/campaign';
import RouteMap from './RouteMap.astro';
---
<section id="the-run" class="section surface-dark grain" aria-labelledby="the-run-title">
  <div class="wrap">
    <p class="eyebrow">{challenge.eyebrow}</p>
    <h2 id="the-run-title" class="display section-title">{challenge.heading}</h2>
    <hr class="rule" />

    <p class="lead">{challenge.body[0]}</p>
    <p>{challenge.body[1]}</p>

    <RouteMap />
  </div>
</section>

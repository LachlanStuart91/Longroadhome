---
import { trackRecord, links } from '../data/campaign';
---
<section id="track-record" class="track surface-light" aria-labelledby="track-title">
  <div class="wrap track__layout">
    <div class="track__copy">
      <h2 id="track-title" class="editorial-title">58 marathons.<br />58 states.<br />58 days.</h2>
      <p>{trackRecord.running2025}</p>
      <p class="track__result">{trackRecord.distance2025}. {trackRecord.raised2025} for {trackRecord.raisedFor2025}.</p>
      <p class="track__earlier">Before that, in 2022, I rowed 30 marathon distances in 30 days.</p>
      <a class="text-link" href={links.statesOfMind}>The story at States of Mind <span aria-hidden="true">↗</span></a>
    </div>
    <figure class="documentary">
      <img src="/images/on-the-road.jpeg" width="3374" height="1914"
           alt="Lachlan beside the camper, with a dog looking through its door window."
           loading="lazy" decoding="async" />
      <figcaption>Life around the running.</figcaption>
    </figure>
  </div>
</section>
<style>
  .track { padding-block: var(--editorial-space); }
  .track__layout { display: flex; flex-direction: column; gap: 2.5rem; }
  .track__copy { display: grid; grid-template-columns: 1fr 1.3fr; column-gap: clamp(2.5rem, 8vw, 7rem); align-items: start; }
  .track h2 { grid-column: 1; grid-row: 1 / 5; margin: 0; }
  .track__copy > p, .track__copy > a { grid-column: 2; }
  .track .documentary { width: 100%; }
  .track__copy p { color: var(--on-light-2); }
  .track__result { color: var(--terrain) !important; font-weight: 600; }
  .track__earlier { font-size: .9375rem; }
  .track .text-link { margin-top: .75rem; }
  @media (max-width: 56.25rem) { .track__copy { display: block; max-width: 42rem; } .track h2 { margin-bottom: 1.5rem; } }
</style>

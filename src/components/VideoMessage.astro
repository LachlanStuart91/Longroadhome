---
import posterImage from '../images/video-poster-lachlan-stuart.jpg';
import { video } from '../data/campaign';
---
<figure id="watch" class="watch">
  <video controls preload="none" playsinline poster={posterImage.src}
         width="1280" height="720" aria-label={video.label}>
    <source src="/video/the-long-road-home-message.mp4" type="video/mp4" />
    <p>{video.fallback} <a href="/video/the-long-road-home-message.mp4" download>{video.fallbackLink}</a>.</p>
  </video>
</figure>
<style>
  .watch { margin: 0; min-width: 0; }
  .watch video { display: block; width: 100%; height: auto; background: #000; }
  .watch a { color: var(--terrain); }
</style>

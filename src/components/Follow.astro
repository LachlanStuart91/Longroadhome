---
import { newsletter, privacy, links } from '../data/campaign';
---
<section id="follow" class="follow surface-light" aria-labelledby="follow-title">
  <div class="wrap follow__layout">
    <header>
      <p class="eyebrow">{newsletter.eyebrow}</p>
      <h2 id="follow-title">{newsletter.heading}</h2>
      <p>{newsletter.promise}</p>
    </header>

    <div class="follow__form">
      <div class="follow__loading" data-newsletter-loading hidden>
        <p class="follow__helper" role="status" data-newsletter-status>Loading the email signup…</p>
        <button type="button" class="text-link follow__retry" data-newsletter-retry hidden>Reload the signup form</button>
      </div>
      <div class="ml-embedded" data-form="q8HCNv"></div>
      <noscript>
        <p class="follow__helper">The signup form needs JavaScript to load. Turn it on and reload the page to subscribe.</p>
      </noscript>
      <p class="follow__notice">
        {privacy.collectionNotice}{' '}
        <a href={links.privacy}>{privacy.collectionNoticeLink}</a>{' '}
        {privacy.collectionNoticeTail}
      </p>
    </div>
  </div>
</section>

<script is:inline>
  (function(w,d,e,u,f,l,n){w[f]=w[f]||function(){(w[f].q=w[f].q||[])
  .push(arguments);},l=d.createElement(e),l.async=1,l.src=u,
  n=d.getElementsByTagName(e)[0],n.parentNode.insertBefore(l,n);})
  (window,document,'script','https://assets.mailerlite.com/js/universal.js','ml');
  ml('account', '2595519');
</script>

<script>
  // Add accessible client-side feedback to the supplied form. Valid submissions,
  // provider validation and double opt-in remain owned by MailerLite.
  const embed = document.querySelector<HTMLElement>('.ml-embedded[data-form="q8HCNv"]');
  if (embed) {
    const loading = document.querySelector<HTMLElement>('[data-newsletter-loading]');
    const status = document.querySelector<HTMLElement>('[data-newsletter-status]');
    const retry = document.querySelector<HTMLButtonElement>('[data-newsletter-retry]');
    if (loading) loading.hidden = false;
    const loadingTimeout = window.setTimeout(() => {
      if (loading?.hidden) return;
      if (status) status.textContent = "The email signup hasn't loaded. Please reload, or try again with content blockers turned off for this site.";
      if (retry) retry.hidden = false;
    }, 10000);
    retry?.addEventListener('click', () => window.location.reload());

    const enhancedEmails = new WeakMap<HTMLInputElement, () => void>();

    const enhanceEmail = (input: HTMLInputElement) => {
      const existing = enhancedEmails.get(input);
      if (existing) {
        existing();
        return;
      }

      const group = input.closest('.ml-field-group');
      // Reflect the provider's existing required rule in native validation.
      // Name remains optional; do not change the provider's submission handler.
      input.required = input.getAttribute('aria-required') === 'true'
        || !!group?.classList.contains('ml-validate-required');

      const error = document.createElement('p');
      error.id = `${input.id}-error`;
      error.className = 'newsletter-error';
      error.setAttribute('role', 'alert');
      error.setAttribute('aria-atomic', 'true');
      input.after(error);
      const descriptions = new Set((input.getAttribute('aria-describedby') || '').split(/\s+/).filter(Boolean));
      descriptions.add(error.id);
      input.setAttribute('aria-describedby', [...descriptions].join(' '));

      let attempted = false;
      const showError = (invalid: boolean) => {
        const message = !invalid ? '' : input.value.trim()
          ? 'Please enter a valid email address.'
          : 'Please enter your email address.';
        if (error.textContent !== message) error.textContent = message;
        input.setAttribute('aria-invalid', String(invalid));
        if (invalid) input.setAttribute('aria-errormessage', error.id);
        else input.removeAttribute('aria-errormessage');
      };

      input.addEventListener('invalid', (event) => {
        // Keep the error visible in the page instead of a temporary browser popup.
        // Cancelling this event does not permit an invalid form submission.
        event.preventDefault();
        attempted = true;
        showError(true);
        input.focus();
      });
      input.addEventListener('input', () => {
        if (!attempted) return;
        const invalid = !input.validity.valid;
        if (!invalid) group?.classList.remove('ml-error');
        showError(invalid);
      });

      // MailerLite may reject values beyond the browser's own email rules.
      // Surface those errors too, including after asynchronous form rendering.
      const syncProviderError = () => {
        if (!group?.classList.contains('ml-error')) return;
        const newlyInvalid = !error.textContent;
        attempted = true;
        showError(true);
        if (newlyInvalid) input.focus();
      };
      enhancedEmails.set(input, syncProviderError);
      syncProviderError();
    };

    const enhanceForm = () => {
      if (embed.querySelector('input[name="fields[email]"]')) {
        if (loading) loading.hidden = true;
        window.clearTimeout(loadingTimeout);
      }
      for (const [field, labelText] of [['name', 'Name'], ['email', 'Email']]) {
        const input = embed.querySelector<HTMLInputElement>(`input[name="fields[${field}]"]`);
        if (!input) continue;
        input.id ||= `journey-${field}`;
        if (!input.labels?.length) {
          const label = document.createElement('label');
          label.htmlFor = input.id;
          label.textContent = labelText;
          input.before(label);
          input.setAttribute('aria-label', labelText);
        }
        if (field === 'email') enhanceEmail(input);
      }
    };
    enhanceForm();
    const observer = new MutationObserver(enhanceForm);
    observer.observe(embed, { childList: true, subtree: true, attributes: true, attributeFilter: ['class'] });
    window.addEventListener('pagehide', (event) => {
      if (!event.persisted) {
        observer.disconnect();
        window.clearTimeout(loadingTimeout);
      }
    });
  }
</script>

<style>
  .follow { padding-block: var(--editorial-space); background: #d4dbcf; }
  .follow__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 25rem;
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: start;
  }
  .follow h2 {
    margin: 0; max-width: 17ch; font-family: var(--font-support);
    font-size: clamp(2.25rem, 3.7vw, 3.5rem); font-weight: 600;
    letter-spacing: -.025em; line-height: 1.12;
  }
  .follow header > p:not(.eyebrow) { margin: 1.25rem 0 0; max-width: 32rem; color: var(--on-light-2); }
  .follow__form { min-height: 20rem; min-width: 0; }
  .follow__notice {
    width: 100%; max-width: 400px; margin: 1.25rem auto 0;
    color: var(--on-light-2); font-size: .875rem; line-height: 1.6;
  }
  .follow__notice a { color: var(--terrain); text-underline-offset: .18em; }
  .follow__helper { color: var(--on-light-2); font-size: .875rem; }
  .follow__loading[hidden], .follow__retry[hidden] { display: none; }
  .follow__retry { border: 0; padding-inline: 0; background: transparent; cursor: pointer; text-decoration: underline; }
  .follow__loading { margin-bottom: 1rem; }
  .follow :global(.ml-form-embedWrapper) { background: transparent !important; }
  .follow :global(.ml-form-embedWrapper .ml-form-embedBody) { padding: 0 !important; }
  .follow :global(.ml-form-embedContent) { display: none; }
  #follow :global(.ml-embedded .ml-form-embedContainer .ml-form-embedWrapper .ml-form-embedBody .ml-form-fieldRow input) {
    font-family: var(--font-body); font-size: 1rem !important; border-radius: 2px !important;
  }
  .follow :global(.ml-field-group label) { color: var(--near) !important; }
  .follow :global(.ml-field-group .newsletter-error) {
    margin: .5rem 0 0; color: #8a2424;
    font: 400 .875rem/1.5 var(--font-body);
  }
  .follow :global(.newsletter-error:empty) { display: none; }
  @media (max-width: 56.25rem) {
    .follow__layout { grid-template-columns: 1fr; gap: 1.75rem; }
    .follow__form { max-width: 25rem; width: 100%; }
  }
</style>

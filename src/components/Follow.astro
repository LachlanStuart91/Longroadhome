---
import { newsletter, privacy, links } from '../data/campaign';

/**
 * The supplied MailerLite embed, used exactly as provided.
 *
 * The universal script is rendered with is:inline so Astro does not process,
 * bundle or duplicate it, and it appears once on the page. MailerLite renders
 * the fields, button, validation, consent wording and confirmation behaviour
 * from the account configuration. Nothing here overrides any of that, and no
 * submission endpoint is invented or rebuilt.
 *
 * Email signup is the ONLY action in this section. The Strava invitation that
 * used to sit beside it has moved to the footer as a quiet text link, so
 * nothing here competes with the form for a reader's attention.
 *
 * SOURCE ORDER IS THE READING ORDER: heading and introduction, then the form
 * and its collection notice. That is also the stacked visual order, so no CSS
 * order values are used anywhere in this component.
 */
---
<section id="follow" class="section surface-light" aria-labelledby="follow-title">
  <div class="wrap">
    <div class="two-col follow-grid">
      <div class="follow-intro">
        <h2 id="follow-title" class="display section-title">{newsletter.heading}</h2>
        <hr class="rule" />
        <p class="lead">{newsletter.promise}</p>
      </div>

      <div class="form-slot">
        <div class="ml-embedded" data-form="q8HCNv"></div>
        <noscript>
          <p class="helper">
            The signup form needs JavaScript to load. Turn it on and reload the page to subscribe.
          </p>
        </noscript>

        {/*
          Our own collection notice, in our own markup, directly beneath the
          embed. It is here rather than inside the MailerLite form because the
          form is built in their old builder and cannot carry a link. It must
          always describe the live form, which currently asks for a name and an
          email address and sends a confirmation before the subscription starts.
        */}
        <p class="collection-notice">
          {privacy.collectionNotice}{' '}
          <a href={links.privacy}>{privacy.collectionNoticeLink}</a>{' '}
          {privacy.collectionNoticeTail}
        </p>
      </div>
    </div>
  </div>
</section>

<!-- MailerLite Universal -->
<script is:inline>
    (function(w,d,e,u,f,l,n){w[f]=w[f]||function(){(w[f].q=w[f].q||[])
    .push(arguments);},l=d.createElement(e),l.async=1,l.src=u,
    n=d.getElementsByTagName(e)[0],n.parentNode.insertBefore(l,n);})
    (window,document,'script','https://assets.mailerlite.com/js/universal.js','ml');
    ml('account', '2595519');
</script>
<!-- End MailerLite Universal -->

<style>
  /* Space is reserved so a slow script does not shift the page when the form
     appears. The form itself is rendered entirely by MailerLite. */
  .form-slot { min-height: 20rem; }
  @media (max-width: 56.25rem) { .form-slot { min-height: 0; } }

  /* Matched to the MailerLite card rather than to the text measure. The card
     is 400px wide with a 20px inner inset, so the notice takes the same width
     and the same inset and its text lines up with the form's own content
     instead of starting 55px to the left of it. Full width on narrow screens,
     where the card is already full width. */
  .collection-notice {
    margin-top: var(--space-5);
    width: 100%;
    max-width: 400px;
    margin-inline: auto;
    padding-inline: 20px;
    box-sizing: border-box;
    font-size: var(--size-helper); line-height: 1.6; color: var(--on-light-2);
  }
  .collection-notice a { color: var(--terrain); text-underline-offset: 0.18em; }
  .collection-notice a:hover, .collection-notice a:focus-visible { color: var(--near); }

  /* Wider screens: ONE centred column, not two.
     With the Strava block gone, a two column layout left roughly 530 by 400px
     of empty floor beside a two line introduction, because the form card is
     552px tall and nothing is allowed to fill that space. Narrowing to a single
     measure removes the void instead of decorating it, and it makes the form
     the only thing in the section.

     Heading, rule, introduction, form and notice all share one left edge, so
     the column reads as a deliberate stack rather than as centred fragments. */
  @media (min-width: 56.25rem) {
    .follow-grid {
      display: block;
      max-width: 40rem;
      margin-inline: auto;
    }
    .follow-intro { margin-bottom: var(--space-7); }
    /* The introduction's own trailing margin would otherwise collapse into the
       margin above, so it is cleared to keep the gap at exactly space-7. */
    .follow-intro > :last-child { margin-bottom: 0; }
    .form-slot { width: 400px; max-width: 100%; margin-inline: 0; }
  }

  /* Stacked: the source order as it stands, with no order values. Heading and
     introduction, then the form, then the collection and privacy notice. */
  @media (max-width: 56.25rem) {
    .follow-grid { display: flex; flex-direction: column; }
  }
</style>

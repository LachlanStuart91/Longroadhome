---
import { Image } from 'astro:assets';
import wordmark from '../images/wordmark-long-road-home.png';
import { links, campaign, event, topBlokes, ui } from '../data/campaign';
---
<footer class="footer surface-dark">
  <div class="wrap footer__main">
    <div>
      <Image class="footer__mark" src={wordmark} alt="The Long Road Home"
             width={460} height={230} widths={[230, 460]} sizes="230px" loading="lazy" />
      <p class="footer__summary">
        {campaign.planningDistance} from {campaign.start} to {campaign.finish}.
        Planned start {campaign.plannedStart}. Raising {campaign.fundraisingTarget} for {campaign.beneficiary}.
      </p>
    </div>

    <div class="footer__links">
      <nav aria-label="Campaign">
        <p>Campaign</p>
        <ul>
          {event.active && <li><a href="/#long-lunch">Long Lunch{event.soldOut ? ' (sold out)' : ''}</a></li>}
          <li><a href={links.communityChallenge}>Community Challenge</a></li>
          <li><a href={links.fundraising} target="_blank" rel="noopener noreferrer">{topBlokes.donateLabel}<span class="visually-hidden">, {ui.newTab}</span></a></li>
          <li><a href={links.partnerEmail}>Partnership enquiries</a></li>
          <li><a href={links.privacy}>Privacy</a></li>
        </ul>
      </nav>

      <nav aria-label="Elsewhere">
        <p>Elsewhere</p>
        <ul>
          <li><a href={links.lachlanStuart} rel="noopener">Lachlan Stuart</a></li>
          <li><a href={links.statesOfMind} rel="noopener">States of Mind</a></li>
          <li><a href={links.topBlokes} rel="noopener">Top Blokes Foundation</a></li>
          <li><a href={links.instagram} target="_blank" rel="noopener noreferrer">Instagram<span class="visually-hidden">, {ui.newTab}</span></a></li>
          <li><a href={links.strava} target="_blank" rel="noopener noreferrer">View on Strava<span class="visually-hidden">, {ui.newTab}</span></a></li>
        </ul>
      </nav>
    </div>
  </div>

  <div class="wrap footer__bottom">
    <span>The Long Road Home · Lachlan Stuart</span>
    <span>Brisbane, Australia</span>
  </div>
</footer>

<style>
  .footer { padding: 3rem 0 1.5rem; background: var(--near); }
  .footer__main {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(22rem, .8fr);
    gap: clamp(3rem, 10vw, 10rem);
  }
  .footer__mark { display: block; width: 11rem; max-width: 100%; height: auto; }
  .footer__summary { margin-top: .75rem; max-width: 29rem; color: var(--on-dark-2); font-size: .875rem; }
  .footer__links { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2.5rem; }
  .footer nav > p {
    margin: 0 0 1rem; color: var(--road); font-family: var(--font-support);
    font-size: .75rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase;
  }
  .footer ul { margin: 0; padding: 0; list-style: none; }
  .footer :global(a) {
    display: inline-block; padding: .28rem 0; color: rgba(230,227,218,.68);
    font-size: .875rem; text-decoration: none;
  }
  .footer :global(a:hover), .footer :global(a:focus-visible) { color: var(--gold); }
  .footer__bottom {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem;
    margin-top: 2rem; color: var(--on-dark-2); font-size: .875rem;
  }
  @media (max-width: 56.25rem) {
    .footer__main { grid-template-columns: 1fr; }
    .footer__links { max-width: 32rem; }
  }
  @media (max-width: 30rem) {
    .footer__links { grid-template-columns: 1fr; }
  }
</style>

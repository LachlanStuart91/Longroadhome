---
import { Image } from 'astro:assets';
import TicketLink from './TicketLink.astro';
import wordmark from '../images/wordmark-long-road-home.png';
import { links, campaign, event, topBlokes, ui } from '../data/campaign';
---
<footer class="site-footer surface-dark">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <Image class="footer-mark" src={wordmark} alt="The Long Road Home"
               width={460} height={230} widths={[230, 460]} sizes="230px" loading="lazy" />
        <p class="helper footer-summary">
          {campaign.planningDistance} from {campaign.start} to {campaign.finish}.
          Planned start {campaign.plannedStart}. Fundraising target of{' '}
          {campaign.fundraisingTarget} for {campaign.beneficiary}.
        </p>

        {/*
          Text only, deliberately. Neither mark could be confirmed as licensed
          for this use: Strava publishes logo licences only for their OAuth
          button and for apps displaying Strava API content, and directs every
          other link to plain text. Approximating or recolouring either logo is
          forbidden by both companies, so no icon and no empty icon slot is
          rendered here.
        */}
        <nav class="social" aria-label="Social media">
          <ul>
            <li>
              <a href={links.instagram} target="_blank" rel="noopener noreferrer">
                <span class="visually-hidden">Lachlan Stuart on </span>Instagram<span
                  class="visually-hidden">, {ui.newTab}</span>
              </a>
            </li>
            <li>
              {/*
                The visible phrase stays contiguous in the accessible name, so a
                speech-input user saying "View on Strava" matches the control.
                Splitting the label around the club name failed WCAG 2.5.3, so
                every extra word now follows the visible text instead.
              */}
              <a href={links.strava} target="_blank" rel="noopener noreferrer">
                View on Strava<span class="visually-hidden">, Lachlan Stuart | Capable of More, {ui.newTab}</span>
              </a>
            </li>
          </ul>
        </nav>
      </div>

      <nav aria-label="Related sites">
        <ul>
          <li><a href={links.lachlanStuart} rel="noopener">Lachlan Stuart</a></li>
          <li><a href={links.statesOfMind} rel="noopener">States of Mind</a></li>
          <li><a href={links.topBlokes} rel="noopener">Top Blokes Foundation</a></li>
        </ul>
      </nav>

      {/*
        Approved order: tickets, donate, partnership, privacy. Instagram and
        Strava are no longer campaign actions and live in the brand column as
        quiet social links. Privacy lives in the footer only, never in the
        campaign navigation.
      */}
      <nav aria-label="Campaign">
        <ul>
          {event.active && <li><TicketLink class="">Long Lunch tickets</TicketLink></li>}
          <li>
            <a href={links.fundraising} target="_blank" rel="noopener noreferrer">
              {topBlokes.donateLabel}<span class="visually-hidden">, {ui.newTab}</span>
            </a>
          </li>
          <li><a href={links.partnerEmail}>Partnership enquiries</a></li>
          <li><a href={links.privacy}>Privacy</a></li>
        </ul>
      </nav>

    </div>

    <div class="footer-bottom">
      <span>The Long Road Home. Lachlan Stuart.</span>
      <span>Brisbane, Australia</span>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--near); padding: var(--space-8) 0 var(--space-6); border-top: 1px solid var(--hairline-dark); }
  .footer-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr; gap: var(--space-6); }
  @media (max-width: 56.25rem) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 35rem) { .footer-grid { grid-template-columns: 1fr; } }

  .footer-mark { width: 230px; max-width: 100%; height: auto; display: block; }
  .footer-summary { margin-top: var(--space-4); max-width: 34ch; }

  .site-footer ul { list-style: none; margin: 0; padding: 0; }

  /* :global is required, not decorative. The ticket link is rendered by
     TicketLink.astro, so it carries that component's scope hash and a plain
     `.site-footer a` rule never matches it. Without this the ticket link falls
     back to the browser default blue underline on the near-black footer. */
  .site-footer :global(a) {
    display: block; color: var(--on-dark-2); text-decoration: none;
    font-size: 0.9375rem; padding: var(--space-1) 0;
  }
  .site-footer :global(a:hover), .site-footer :global(a:focus-visible) { color: var(--gold); }

  /* Quiet social links. Small, in the secondary footer colour, at the footer's
     own size, so they are findable without competing with the email form above
     them or the donation link beside them. The 44px minimum height is a
     comfortable target, not a button. */
  .social { margin-top: var(--space-5); }
  .social ul { display: flex; flex-wrap: wrap; gap: 0 1.25rem; }
  /* inline-block, NOT inline-flex. A flex container turns each run of text into
     an anonymous flex item and discards the whitespace between them, which
     rendered the Strava label as "Viewon Strava" because its accessible-name
     span sits mid-label. line-height gives the 44px target height and centres
     the label inside it without touching the inline text flow. */
  .site-footer nav.social a {
    display: inline-block;
    line-height: 44px;
    min-height: 44px;
    padding: 0;
    font-size: 0.9375rem;
    color: var(--on-dark-2);
    text-decoration: none;
  }
  /* Hover and keyboard focus lift the label to full Road White and underline
     it. Deliberately not gold: gold belongs to the donation action. The global
     focus-visible ring still applies on top of this. */
  .site-footer nav.social a:hover,
  .site-footer nav.social a:focus-visible {
    color: var(--on-dark-1);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .footer-bottom {
    margin-top: var(--space-7); padding-top: var(--space-5);
    border-top: 1px solid var(--hairline-dark);
    color: var(--on-dark-2); font-size: var(--size-helper);
    display: flex; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap;
  }
</style>

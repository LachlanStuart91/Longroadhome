---
import { Image } from 'astro:assets';
import topBlokesLogo from '../images/top-blokes-proud-supporter-logo.png';
import { campaign, topBlokes, links, ui } from '../data/campaign';
---
<section id="top-blokes" class="tb surface-light" aria-labelledby="tb-title">
  <div class="wrap">
    <div class="tb__layout">
      <div class="tb__story">
        <p class="eyebrow">{topBlokes.eyebrow}</p>
        <h2 id="tb-title" class="editorial-title">{topBlokes.heading}</h2>
        <p class="tb__reason">{topBlokes.reason}</p>
        <p>{topBlokes.programBody}</p>
        <a class="text-link" href={links.topBlokes}>{topBlokes.aboutLabel} <span aria-hidden="true">↗</span></a>
      </div>
      <section id="donate" class="tb__donate" aria-labelledby="donate-title">
        <h3 id="donate-title" class="tb__amount">{campaign.fundraisingTarget}<span>{topBlokes.targetLabel}</span></h3>
        <p>Help me get there. Donations through the campaign's Raisely page go directly to Top Blokes Foundation.</p>
        <a class="btn btn--dark" href={links.fundraising}>Donate on Raisely <span aria-hidden="true">↗</span></a>
        <Image class="tb__logo" src={topBlokesLogo} alt="Proud supporter of Top Blokes Foundation"
               widths={[180,360]} sizes="150px" format="png" loading="lazy" />
      </section>
    </div>
    <details class="tb__evidence">
      <summary>Research and support</summary>
      <div class="tb__evidence-content">
        <dl>
          {topBlokes.evidence.map((item) => (
            <div><dt>{item.qualifier} {item.figure}</dt><dd>{item.description}</dd></div>
          ))}
        </dl>
        <p class="tb__sources">
          {topBlokes.sourceLine.map((seg) => seg.href
            ? <a href={seg.href} target="_blank" rel="noopener">{seg.text}<span class="visually-hidden">, {ui.newTab}</span></a>
            : seg.text)}
        </p>
        <p class="tb__support">
          {topBlokes.supportLine.map((seg) => !seg.href
            ? seg.text
            : seg.href.startsWith('tel:')
              ? <a href={seg.href}>{seg.text}</a>
              : <a href={seg.href} target="_blank" rel="noopener">{seg.text}<span class="visually-hidden">, {ui.newTab}</span></a>)}
        </p>
      </div>
    </details>
  </div>
</section>
<style>
  .tb { padding-block: var(--editorial-space); background: #faf9f5; }
  .tb__layout { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); gap: clamp(2.5rem, 8vw, 7rem); align-items: start; }
  .tb__story > p { color: var(--on-light-2); }
  .tb__story .eyebrow { color: var(--terrain); }
  .tb__reason { margin-top: 1.75rem; font-size: 1.125rem; }
  .tb__amount { font-family: var(--font-display); font-weight: 400; font-size: clamp(4rem, 6vw, 6rem); line-height: 1; color: var(--terrain); margin: 0 0 1.5rem; }
  .tb__amount span { display: block; font: 400 .875rem/1.5 var(--font-body); margin-top: .5rem; color: var(--on-light-2); }
  .tb__donate > p { font-size: 1rem; color: var(--on-light-2); }
  .tb__donate .btn { gap: 1rem; margin-top: .5rem; white-space: normal; }
  .tb__logo { width: 9.5rem; height: auto; margin-top: 2rem; }
  .tb__evidence { margin-top: 2.5rem; max-width: 65rem; }
  .tb__evidence summary { width: fit-content; padding-block: .5rem; color: var(--terrain); font-size: .9375rem; cursor: pointer; }
  .tb__evidence summary:hover { text-decoration: underline; text-underline-offset: .2em; }
  .tb__evidence-content { padding-top: 1rem; }
  .tb__evidence dl { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin: 0 0 1.5rem; }
  .tb__evidence dt { font-weight: 600; font-size: 1.125rem; }
  .tb__evidence dd { margin: .5rem 0 0; color: var(--on-light-2); }
  .tb__sources, .tb__support { max-width: none; color: var(--on-light-2); font-size: .875rem; }
  .tb__evidence a { color: var(--terrain); text-underline-offset: .2em; }
  .tb__support a[href^='tel:'] { white-space: nowrap; }
  @media (max-width: 56.25rem) { .tb__layout { grid-template-columns: 1fr; } }
  @media (max-width: 38rem) { .tb__evidence dl { grid-template-columns: 1fr; } }
</style>

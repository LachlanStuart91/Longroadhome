---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { meta } from '../data/campaign';

interface Props {
  title?: string;
  description?: string;
  socialTitle?: string;
  socialDescription?: string;
}
const {
  title = meta.title,
  description = meta.description,
  socialTitle = meta.socialTitle,
  socialDescription = meta.socialDescription,
} = Astro.props;
// Normalise so the homepage canonical is the bare origin, and so a built page
// such as privacy.html is canonicalised as /privacy rather than /privacy.html.
const canonicalPath = Astro.url.pathname
  .replace(/index\.html$/, '')
  .replace(/\.html$/, '');
const canonical = new URL(canonicalPath, Astro.site).href;
// Scrapers need an absolute URL, so the approved card is resolved against the site origin.
const socialImage = new URL(meta.socialImage, Astro.site).href;
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:site_name" content={meta.siteName} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content={meta.socialImageType} />
    <meta property="og:image:width" content={meta.socialImageWidth} />
    <meta property="og:image:height" content={meta.socialImageHeight} />
    <meta property="og:image:alt" content={meta.socialImageAlt} />
    {/* Twitter is given its own title and description rather than inheriting
        the og: pair. Both reuse the already approved social copy verbatim. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={meta.socialImageAlt} />

    {/* Favicon. Stable filenames: browsers and search results identify the
        site by this icon, so these paths should not change once published. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href="/fonts/bebas-neue-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#031307" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to main content</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
